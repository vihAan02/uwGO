# ---- Server-side key (NEVER exposed to the browser) ----
# Google Cloud Console → Credentials → API key
#   Application restriction: none (or your server IPs if you self-host)
#   API restrictions: Routes API, Geocoding API  (nothing else)
GOOGLE_MAPS_SERVER_KEY=

# ---- Browser key (inlined into the client bundle at build time) ----
#   Application restriction: HTTP referrers, e.g. https://your-domain.example/* and http://localhost:3000/*
#   API restrictions: Maps JavaScript API  (nothing else)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional: a Map ID from Google Cloud Console → Map Management (enables Advanced Markers styling)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
